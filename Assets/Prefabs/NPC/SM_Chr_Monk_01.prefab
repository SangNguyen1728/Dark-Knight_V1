--- !u!114 &4354315852828117972
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 608330824934495502}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ef8e21e4f4354db4ea133482ba745876, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  ShowTopMostFoldoutHeaderGroup: 1
  interactableText: "Beneath the roots where stars forgot their names, A whisper
    burns \u2014 yet colder than the flame. The moon once wept for suns that never
    rose, Their light devoured by truths no mortal knows.  Seek not the dawn \u2014
    it hides within the grave, Where shadows kneel, and silence learns to crave.
    One step through time, and memory shall bend \u2014 The light thou seek\u2019st
    was never thine to end.  Touch the mirror made of sigh and bone, Speak the word
    that none have ever known. The path shall bloom where darkness bled \u2014 Find
    the sun among the dead."
  interactableCollider: {fileID: 5994355478583064577}
  hostOnlyInteractable: 1
